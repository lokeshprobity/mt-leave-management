# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# Database Configuration (PostgreSQL / Cloud SQL)
SQL_HOST=
SQL_DB_NAME=
SQL_USER=
SQL_PASSWORD=
SQL_ADMIN_USER=
SQL_ADMIN_PASSWORD=

# Email & Credential Delivery Configuration
# Recommended on Render Free: Resend HTTPS API (create a key at https://resend.com/api-keys)
RESEND_API_KEY=
# Must use a sender address on a domain verified in Resend, e.g. MT Leave <no-reply@your-verified-domain.com>
RESEND_FROM=
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM="no-reply@maestro.com"
APP_LOGIN_URL="/#login"

